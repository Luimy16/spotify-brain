{
  "cerebro_spotify": {
    "nombre": "Cerebro Spotify",
    "version": "1.0.0",
    "modelo": "RSC_Harness_agents",
    "autor": "testeer",
    "descripcion": "IA nueva desde cero para hacer reproducciones en Spotify. 6 agentes especializados que trabajan en cadena.",
    "archivos": [
      "brain/cerebro.py",
      "brain/agentes/*/SKILL.md",
      "config/agentes.json",
      "data/*.json"
    ],
    "neuronas": {
      "activas": ["cerebro", "creador", "proxy", "vision", "audio", "registro"],
      "dormidas_por_defecto": true,
      "activacion_selectiva": true
    }
  },
  "agentes": [
    {
      "nombre": "cerebro",
      "rol": "jefe_orquestacion",
      "descripcion": "Decide qué agente activar, en qué orden, y cuándo está todo perfecto.",
      "neuronas": ["clasificar_tarea", "activar_segun_rol", "desactivar_dormidos"],
      "disparo": "siempre"
    },
    {
      "nombre": "creador",
      "rol": "creador_cuentas",
      "descripcion": "Crea cuentas de Spotify con emulación de IP/lugar/hora.",
      "neuronas": ["emular_ip", "crear_cuenta", "verificar_cuenta", "registrar_cuenta"],
      "disparo": "cuando_necesita_cuenta"
    },
    {
      "nombre": "proxy",
      "rol": "gestor_proxies",
      "descripcion": "Busca, prueba, guarda y gestiona proxies para Spotify.",
      "neuronas": ["buscar_proxies", "probar_proxy", "guardar_proxos", "rotar_proxy"],
      "disparo": "cuando_necesita_proxy"
    },
    {
      "nombre": "vision",
      "rol": "vision_ui",
      "descripcion": "Ve la pantalla, localiza botones, se adapta a cambios de UI.",
      "neuronas": ["capturar", "detectar_elementos", "localizar_boton", "adaptar_ui"],
      "disparo": "cuando_necesita_ver"
    },
    {
      "nombre": "audio",
      "rol": "validador_reproduccion",
      "descripcion": "Escucha y valida que la reproducción realmente funciona.",
      "neuronas": ["verificar_play", "escuchar_audio", "detectar_corte", "medir_duracion"],
      "disparo": "cuando_necesita_escuchar"
    },
    {
      "nombre": "registro",
      "rol": "memoria_persistente",
      "descripcion": "Guarda todo lo que pasa. Es la memoria del cerebro.",
      "neuronas": ["guardar", "consultar", "aprender", "limpiar"],
      "disparo": "siempre"
    }
  ],
  "flujos": {
    "crear_cuenta": ["creador", "proxy", "registro"],
    "reproducir": ["audio", "vision", "registro"],
    "validar_proxy": ["proxy", "registro"],
    "ver_ui": ["vision", "registro"],
    "todo": ["cerebro", "creador", "proxy", "vision", "audio", "registro"]
  }
}
